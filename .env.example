# Configure these variables in your production environment (e.g. Vercel, Netlify,
# or your Node.js backend container). Never commit active production secrets to git.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=leads@lwepatientcare.in
SMTP_PASS=your_app_password_here
